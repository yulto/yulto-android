{
  "appId": "com.yultocare.app",
  "appName": "YULTO CARE",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["yulto-ai.kathikabalasooriya.workers.dev"]
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorSQLite": {
      "androidDatabaseLocation": "default",
      "iosDatabaseLocation": "Library/CapacitorDatabase"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#2563eb"
    }
  }
}
