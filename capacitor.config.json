{
  "appId": "com.yultocare.app",
  "appName": "OPSIN MEDICALS",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "CapacitorSQLite": {
      "androidDatabaseLocation": "default",
      "iosDatabaseLocation": "Library/CapacitorDatabase"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#2563eb"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#2563eb",
      "showSpinner": false
    }
  }
}
